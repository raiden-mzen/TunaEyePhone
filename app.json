{
  "expo": {
    "name": "TunaEye Kiosk",
    "slug": "tunaeye-kiosk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/tunaEyeLoadingScreen.png",
      "backgroundColor": "#1F5CFF",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TunaEye uses the camera to scan the kiosk QR code."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TunaEye needs access to save receipt images to your gallery.",
          "savePhotosPermission": "TunaEye needs permission to save receipt images to your gallery."
        }
      ]
    ],
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
