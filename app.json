{
  "expo": {
    "name": "TunaEye Kiosk",
    "slug": "tunaeye-kiosk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/tunaEyeLoadingScreen.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tunaEyeLoadingScreen.png",
          "backgroundColor": "#1F5CFF",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TunaEye uses the camera to scan the kiosk QR code."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "TunaEye saves receipts to your gallery.",
          "savePhotosPermission": "TunaEye saves receipts to your gallery."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TunaEye lets you choose a photo of the sample from your gallery."
        }
      ]
    ],
    "android": {
      "package": "com.yourname.tunaeyekiosk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tunaEyeLoadingScreen.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "586da0d4-0404-4dd3-9427-a36a7e22a927"
      }
    }
  }
}